# Example configuration for sni-collector, consumed by the systemd unit
# (deploy/sni-collector.service) via EnvironmentFile=.
#
# Install at /etc/sni-collector/sni-collector.env and adjust the values
# below to match your environment.

SNI_COLLECTOR_ARGS=--interface any --proxy-ip 198.51.100.10 --proxy-port 3128 --output /var/log/sni-collector/sni-collector.log --deduplicate --dedup-ttl 1h --idle-timeout 60s
